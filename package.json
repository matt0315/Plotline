{
  "name": "plotline",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "npm run build && vite preview",
    "lint": "oxlint",
    "types": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply plotline --local",
    "db:migrate:remote": "wrangler d1 migrations apply plotline --remote",
    "deploy": "npm run build && wrangler deploy",
    "feedback": "wrangler d1 execute plotline --remote --command \"SELECT created_at, kind, COALESCE(email, '-') AS email, message, context FROM feedback ORDER BY created_at DESC LIMIT 50\"",
    "feedback:local": "wrangler d1 execute plotline --local --command \"SELECT created_at, kind, COALESCE(email, '-') AS email, message, context FROM feedback ORDER BY created_at DESC LIMIT 50\"",
    "deploy:apex": "wrangler deploy -c wrangler.apex.jsonc"
  },
  "dependencies": {
    "dxf": "^5.3.1",
    "idb-keyval": "^6.3.0",
    "immer": "^11.1.18",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.48.0",
    "lz-string": "^1.5.0",
    "pdfjs-dist": "^5.6.205",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "stripe": "^22.6.2",
    "svg2pdf.js": "^2.8.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.62.0",
    "@expo-google-fonts/cormorant-garamond": "^0.4.1",
    "@expo-google-fonts/dancing-script": "^0.4.2",
    "@expo-google-fonts/great-vibes": "^0.4.1",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/josefin-sans": "^0.4.2",
    "@expo-google-fonts/lora": "^0.4.2",
    "@expo-google-fonts/montserrat": "^0.4.2",
    "@expo-google-fonts/playfair-display": "^0.4.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.13.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "wrangler": "^4.143.0"
  },
  "engines": {
    "node": ">=22"
  }
}
