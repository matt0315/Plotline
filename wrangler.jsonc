{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "plotline",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-20",
  "compatibility_flags": ["nodejs_compat"],

  // Served at www.plotlineapp.online; the bare domain redirects here (see wrangler.apex.jsonc).
  "routes": [{ "pattern": "www.plotlineapp.online", "custom_domain": true }],
  // One canonical address: the workers.dev URL is switched off.
  "workers_dev": false,
  "preview_urls": false,

  // The React app is served as static assets; only /api/* runs the Worker.
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  // Accounts, sessions, and metadata. Create with: npx wrangler d1 create plotline
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "plotline",
      "database_id": "1160e7b1-f7a0-4678-bcba-3c9fc998aaf5",
      "migrations_dir": "migrations"
    }
  ],

  // Event documents and venue drawings. Create with: npx wrangler r2 bucket create plotline-files
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "plotline-files" }],

  // Magic-link sign-in emails. Onboard the domain with: npx wrangler email sending enable plotlineapp.online
  "send_email": [{ "name": "EMAIL" }],

  "vars": {
    "APP_ENV": "production",
    "APP_URL": "https://www.plotlineapp.online",
    "EMAIL_FROM": "hello@plotlineapp.online",
    "APP_NAME": "Plotline",
    // Feedback and item-request alerts. Email Routing forwards this address to the owner's inbox.
    "FEEDBACK_TO": "hello@plotlineapp.online",
    // $39/mo Plotline Pro. Public link, so not a secret. Customers are tagged with their account id.
    "STRIPE_PAYMENT_LINK": "https://buy.stripe.com/3cIcN7c159KT1rugkv6g800"
  },

  "observability": { "enabled": true }
  // Secrets (npx wrangler secret put …): STRIPE_WEBHOOK_SECRET (required for billing), CLOUDCONVERT_API_KEY (optional).
  // Optional: STRIPE_PORTAL_LINK var for "Manage billing"; or STRIPE_SECRET_KEY + STRIPE_PRICE_ID to use the Checkout API instead of the link.
}
