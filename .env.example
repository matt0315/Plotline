# Browser build settings (Vite exposes VITE_* to the client).
# Copy to .env.local for development; set the same in your build environment for production.

# Satellite imagery — set ONE of these (first one set wins).
# Recommended: ArcGIS Location Platform — 2M free tiles/month, commercial use allowed.
VITE_ARCGIS_KEY=
VITE_MAPTILER_KEY=
VITE_MAPBOX_TOKEN=   # also switches venue search to Mapbox geocoding

# Server secrets are NOT set here. They live in Cloudflare:
#   npx wrangler secret put STRIPE_SECRET_KEY
#   npx wrangler secret put STRIPE_PRICE_ID
#   npx wrangler secret put STRIPE_WEBHOOK_SECRET
#   npx wrangler secret put CLOUDCONVERT_API_KEY   (optional — DWG import)
# For local development, put any you need in .dev.vars (already git-ignored).
